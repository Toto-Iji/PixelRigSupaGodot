; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PixelRig"
run/main_scene="res://scenes/login.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Supabase="*res://scripts/singletons/supabase.gd"
SolutionItem="*res://scripts/singletons/SolutionItem.gd"
GameData="*res://scripts/singletons/game_data.gd"
DeviceDetector="*res://scripts/singletons/device_detector.gd"
QuizManager="*res://scripts/singletons/quiz_manager.gd"
QuizCache="*res://scripts/singletons/quiz_cache.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[global_group]

player=""

